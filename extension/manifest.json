{
  "manifest_version": 3,
  "name": "ApplyFlow",
  "version": "0.1.0",
  "description": "Chat with ApplyFlow from Chrome's Side Panel.",
  "permissions": ["sidePanel"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open ApplyFlow"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  }
}
